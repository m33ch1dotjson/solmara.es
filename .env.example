# Supabase — copy to .env.local and fill in. .env.local is gitignored.
#
# The publishable key is meant to be public: it ships to the browser and is
# protected by row level security. The secret key and the database passwords are not
# — they never belong in the repo, in a NEXT_PUBLIC_ variable, or in a chat window.

NEXT_PUBLIC_SUPABASE_URL=https://cifzbfjoceyzjnxzkelj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KpkqKhW7O9v2Qi-Up-jTSg_rvLVI4sT

# Server only. Never prefixed with NEXT_PUBLIC_ — this one ignores RLS entirely.
SUPABASE_SECRET_KEY=

# Two database URLs, two roles, on purpose.
#
# Migrations run as postgres, which owns the schema. The application never does:
# Supabase's postgres role carries rolbypassrls, so running the app on it would make
# every policy decorative while all the tests still passed.
#
# Both use the POOLER host, not db.<ref>.supabase.co: the direct host is IPv6-only and
# the container has no IPv6. The username carries the project ref — that is how the
# pooler routes. Session pooler (5432) keeps prepared statements; the transaction
# pooler (6543) does not.

# drizzle-kit only.
DATABASE_URL=postgresql://postgres.cifzbfjoceyzjnxzkelj:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# The application. app_server is NOBYPASSRLS; its password is generated on the host by
# scripts/set-app-role-password.sh, which writes this line for you.
APP_DATABASE_URL=postgresql://app_server.cifzbfjoceyzjnxzkelj:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

